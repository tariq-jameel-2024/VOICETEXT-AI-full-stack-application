<file path="backend/include/services/STTService.hpp">
#pragma once
#include <memory>
#include <string>

#include "providers/SpeechToTextProvider.hpp"
#include "repositories/TranscriptRepository.hpp"
#include "services/AuthService.hpp"
#include "utils/FileManager.hpp"
#include "utils/Http.hpp"
#include "utils/Logger.hpp"

namespace voicetext {

class STTService {
public:
    STTService(std::unique_ptr<SpeechToTextProvider> provider, TranscriptRepository& transcripts, FileManager& files)
        : provider_(std::move(provider)), transcripts_(transcripts), files_(files) {}

    // Handles a raw uploaded audio payload: validates it, stores it safely,
    // runs it through the configured (or mock) provider, and persists the
    // resulting transcript.
    Json transcribeUpload(const std::string& userId, const std::string& filenameHint, const std::string& mimeType,
                           const std::string& bytes, const std::string& language) {
        if (bytes.empty()) return JsonResponse::fail("Uploaded audio is empty", "EMPTY_AUDIO");
        if (bytes.size() > kMaxAudioBytes) return JsonResponse::fail("Audio file exceeds the 25MB limit", "FILE_TOO_LARGE");
        if (!Validator::isAllowedAudioMime(mimeType)) return JsonResponse::fail("Unsupported audio format", "UNSUPPORTED_FORMAT");

        std::string ext = extensionForMime(mimeType);
        std::string safeName = FileManager::generateSafeFilename(ext);
        if (!files_.saveBinary("audio/uploads", safeName, bytes, kMaxAudioBytes)) {
            return JsonResponse::fail("Unable to store uploaded audio", "STORAGE_ERROR");
        }

        std::string path = files_.absolutePath("audio/uploads", safeName);
        TranscriptResult result;
        try {
            result = provider_->transcribe(path, language);
        } catch (const std::exception& ex) {
            Logger::instance().error(std::string("STT provider failure: ") + ex.what());
            return JsonResponse::fail("Unable to process audio", "STT_PROCESSING_ERROR");
        }
        if (!result.success) return JsonResponse::fail("Unable to process audio", "STT_PROCESSING_ERROR");

        Transcript t;
        t.id = generateId("doc");
        t.userId = userId;
        t.title = "Voice Note";
        t.content = result.text;
        t.language = result.language.empty() ? language : result.language;
        t.type = "voice_to_text";
        t.sourceAudio = safeName;
        t.status = result.isDemo ? "demo" : "completed";
        t.createdAt = t.updatedAt = nowIso();
        transcripts_.create(t);

        return JsonResponse::ok(TranscriptService_toJson(t), "Transcription completed successfully");
    }

private:
    static constexpr size_t kMaxAudioBytes = 25 * 1024 * 1024;
    std::unique_ptr<SpeechToTextProvider> provider_;
    TranscriptRepository& transcripts_;
    FileManager& files_;

    static std::string extensionForMime(const std::string& mime) {
        if (mime == "audio/wav" || mime == "audio/x-wav") return "wav";
        if (mime == "audio/mpeg" || mime == "audio/mp3") return "mp3";
        if (mime == "audio/webm") return "webm";
        if (mime == "audio/ogg") return "ogg";
        return "bin";
    }

    static Json TranscriptService_toJson(const Transcript& t) {
        return Json{
            {"id", t.id}, {"user_id", t.userId}, {"title", t.title}, {"content", t.content},
            {"language", t.language}, {"type", t.type}, {"status", t.status},
            {"created_at", t.createdAt}, {"updated_at", t.updatedAt}};
    }
};

} // namespace voicetext
</file>

<file path="backend/include/services/TranscriptService.hpp">
#pragma once
#include <string>
#include <vector>

#include "models/Models.hpp"
#include "repositories/TranscriptRepository.hpp"
#include "services/AuthService.hpp"
#include "utils/Http.hpp"

namespace voicetext {

class TranscriptService {
public:
    explicit TranscriptService(TranscriptRepository& repo) : repo_(repo) {}

    Json list(const std::string& userId, int page, int pageSize) {
        int offset = std::max(0, (page - 1) * pageSize);
        auto items = repo_.listByUser(userId, pageSize, offset);
        Json arr = Json::array();
        for (auto& t : items) arr.push_back(toJson(t));
        return JsonResponse::ok(arr);
    }

    Json search(const std::string& userId, const std::string& query) {
        auto items = repo_.search(userId, query);
        Json arr = Json::array();
        for (auto& t : items) arr.push_back(toJson(t));
        return JsonResponse::ok(arr);
    }

    Json getOne(const std::string& id, const std::string& userId) {
        auto t = repo_.findById(id);
        if (!t || t->userId != userId) return JsonResponse::fail("Document not found", "NOT_FOUND");
        return JsonResponse::ok(toJson(*t));
    }

    Json create(const std::string& userId, const std::string& title, const std::string& content, const std::string& language,
                const std::string& type, const Json& fields = Json::object()) {
        if (!Validator::isNonEmpty(title, 300)) return JsonResponse::fail("Title is required", "VALIDATION_ERROR");
        Transcript t;
        t.id = generateId("doc");
        t.userId = userId;
        t.title = title;
        t.content = content;
        t.language = language;
        t.type = type.empty() ? "voice_to_text" : type;
        if (fields.contains("source_audio") && !fields["source_audio"].is_null()) {
            t.sourceAudio = fields["source_audio"].get<std::string>();
        }
        if (fields.contains("duration") && !fields["duration"].is_null()) {
            t.duration = fields["duration"].get<int>();
        }
        t.favorite = fields.value("favorite", false);
        t.status = fields.value("status", "completed");
        t.createdAt = t.updatedAt = nowIso();
        repo_.create(t);
        return JsonResponse::ok(toJson(t), "Document saved");
    }

    Json update(const std::string& id, const std::string& userId, const Json& patch) {
        auto existing = repo_.findById(id);
        if (!existing || existing->userId != userId) return JsonResponse::fail("Document not found", "NOT_FOUND");
        Transcript t = *existing;
        if (patch.contains("title")) t.title = patch["title"].get<std::string>();
        if (patch.contains("content")) t.content = patch["content"].get<std::string>();
        if (patch.contains("language")) t.language = patch["language"].get<std::string>();
        if (patch.contains("favorite")) t.favorite = patch["favorite"].get<bool>();
        if (patch.contains("status")) t.status = patch["status"].get<std::string>();
        t.updatedAt = nowIso();
        repo_.update(t);
        return JsonResponse::ok(toJson(t), "Document updated");
    }

    Json remove(const std::string& id, const std::string& userId) {
        auto existing = repo_.findById(id);
        if (!existing || existing->userId != userId) return JsonResponse::fail("Document not found", "NOT_FOUND");
        repo_.remove(id, userId);
        return JsonResponse::ok(nullptr, "Document deleted");
    }

    static Json toJson(const Transcript& t) {
        return Json{
            {"id", t.id}, {"user_id", t.userId}, {"title", t.title}, {"content", t.content},
            {"language", t.language}, {"type", t.type}, {"duration", t.duration ? Json(*t.duration) : Json(nullptr)},
            {"favorite", t.favorite}, {"status", t.status}, {"created_at", t.createdAt}, {"updated_at", t.updatedAt}};
    }

private:
    TranscriptRepository& repo_;
};

} // namespace voicetext
</file>

<file path="backend/include/services/TTSService.hpp">
#pragma once
#include <memory>
#include <string>

#include "providers/TextToSpeechProvider.hpp"
#include "repositories/MediaRepository.hpp"
#include "services/AuthService.hpp"
#include "utils/Http.hpp"

namespace voicetext {

class TTSService {
public:
    TTSService(std::unique_ptr<TextToSpeechProvider> provider, TTSRepository& repo) : provider_(std::move(provider)), repo_(repo) {}

    Json generate(const std::string& userId, const std::string& text, const std::string& language, const std::string& voice, double speed) {
        if (!Validator::isNonEmpty(text, 5000)) return JsonResponse::fail("Text cannot be empty or exceed 5000 characters", "VALIDATION_ERROR");
        if (speed < 0.5 || speed > 2.0) speed = 1.0;

        AudioResult audio = provider_->synthesize(text, language, voice);

        TTSGeneration item;
        item.id = generateId("tts");
        item.userId = userId;
        item.text = text;
        item.language = language;
        item.voice = voice;
        item.speed = speed;
        item.audioPath = audio.audioFilePath.empty() ? std::nullopt : std::optional<std::string>(audio.audioFilePath);
        item.status = audio.isDemo ? "demo" : "completed";
        item.createdAt = nowIso();
        repo_.create(item);

        return JsonResponse::ok(toJson(item), audio.isDemo ? "Speech generated (demo mode — no server audio engine configured)" : "Speech generated");
    }

    Json list(const std::string& userId) {
        auto items = repo_.listByUser(userId);
        Json arr = Json::array();
        for (auto& i : items) arr.push_back(toJson(i));
        return JsonResponse::ok(arr);
    }

    Json remove(const std::string& id, const std::string& userId) {
        auto existing = repo_.findById(id);
        if (!existing || existing->userId != userId) return JsonResponse::fail("Audio not found", "NOT_FOUND");
        repo_.remove(id, userId);
        return JsonResponse::ok(nullptr, "Audio deleted");
    }

    Json toggleFavorite(const std::string& id, const std::string& userId, bool favorite) {
        auto existing = repo_.findById(id);
        if (!existing || existing->userId != userId) return JsonResponse::fail("Audio not found", "NOT_FOUND");
        repo_.updateFavorite(id, userId, favorite);
        existing->favorite = favorite;
        return JsonResponse::ok(toJson(*existing), favorite ? "Saved to favorites" : "Removed from favorites");
    }

    static Json toJson(const TTSGeneration& t) {
        return Json{{"id", t.id}, {"user_id", t.userId}, {"text", t.text}, {"language", t.language},
                    {"voice", t.voice}, {"speed", t.speed}, {"favorite", t.favorite}, {"status", t.status}, {"created_at", t.createdAt}};
    }

private:
    std::unique_ptr<TextToSpeechProvider> provider_;
    TTSRepository& repo_;
};

} // namespace voicetext
</file>

<file path="backend/include/utils/ConfigManager.hpp">
#pragma once
// Loads server configuration from environment variables / a .env file.
// No secrets are ever hardcoded; everything falls back to safe demo defaults
// so the application can run in APP_MODE=demo without external credentials.

#include <fstream>
#include <sstream>
#include <string>
#include <unordered_map>

namespace voicetext {

class ConfigManager {
public:
    static ConfigManager& instance() {
        static ConfigManager cfg;
        return cfg;
    }

    void loadFromFile(const std::string& path = "config/.env") {
        std::ifstream file(path);
        if (!file.is_open()) return; // absent .env is fine, defaults apply
        std::string line;
        while (std::getline(file, line)) {
            if (line.empty() || line[0] == '#') continue;
            auto pos = line.find('=');
            if (pos == std::string::npos) continue;
            std::string key = trim(line.substr(0, pos));
            std::string value = trim(line.substr(pos + 1));
            values_[key] = value;
        }
    }

    std::string get(const std::string& key, const std::string& fallback = "") const {
        if (const char* env = std::getenv(key.c_str())) return std::string(env);
        auto it = values_.find(key);
        return it != values_.end() ? it->second : fallback;
    }

    int getInt(const std::string& key, int fallback) const {
        std::string v = get(key);
        if (v.empty()) return fallback;
        try { return std::stoi(v); } catch (...) { return fallback; }
    }

    bool isDemoMode() const {
        return get("APP_MODE", "demo") == "demo" || get("STT_PROVIDER").empty();
    }

private:
    std::unordered_map<std::string, std::string> values_;

    static std::string trim(const std::string& s) {
        size_t start = s.find_first_not_of(" \t\r\n\"");
        size_t end = s.find_last_not_of(" \t\r\n\"");
        if (start == std::string::npos) return "";
        return s.substr(start, end - start + 1);
    }
};

} // namespace voicetext
</file>

<file path="backend/include/utils/DatabaseManager.hpp">
#pragma once
// RAII wrapper around a single SQLite3 connection. All queries elsewhere in
// the codebase go through this class using parameterized statements only —
// never raw string concatenation — to prevent SQL injection.

#include <sqlite3.h>

#include <filesystem>
#include <functional>
#include <memory>
#include <stdexcept>
#include <string>
#include <vector>

#include "utils/Logger.hpp"

namespace voicetext {

class SqliteStatement {
public:
    SqliteStatement(sqlite3* db, const std::string& sql) : db_(db) {
        if (sqlite3_prepare_v2(db_, sql.c_str(), -1, &stmt_, nullptr) != SQLITE_OK) {
            throw std::runtime_error(std::string("Failed to prepare statement: ") + sqlite3_errmsg(db_));
        }
    }
    ~SqliteStatement() { if (stmt_) sqlite3_finalize(stmt_); }

    SqliteStatement(const SqliteStatement&) = delete;
    SqliteStatement& operator=(const SqliteStatement&) = delete;

    void bind(int index, const std::string& value) { sqlite3_bind_text(stmt_, index, value.c_str(), -1, SQLITE_TRANSIENT); }
    void bind(int index, int value) { sqlite3_bind_int(stmt_, index, value); }
    void bind(int index, double value) { sqlite3_bind_double(stmt_, index, value); }
    void bindNull(int index) { sqlite3_bind_null(stmt_, index); }

    bool step() { return sqlite3_step(stmt_) == SQLITE_ROW; }
    void execute() { sqlite3_step(stmt_); }

    std::string columnText(int col) const {
        const unsigned char* txt = sqlite3_column_text(stmt_, col);
        return txt ? reinterpret_cast<const char*>(txt) : "";
    }
    int columnInt(int col) const { return sqlite3_column_int(stmt_, col); }
    double columnDouble(int col) const { return sqlite3_column_double(stmt_, col); }
    bool isNull(int col) const { return sqlite3_column_type(stmt_, col) == SQLITE_NULL; }

private:
    sqlite3* db_;
    sqlite3_stmt* stmt_ = nullptr;
};

class DatabaseManager {
public:
    explicit DatabaseManager(const std::string& path) {
        if (path != ":memory:") {
            const std::filesystem::path dbPath(path);
            if (!dbPath.parent_path().empty()) {
                std::error_code ec;
                std::filesystem::create_directories(dbPath.parent_path(), ec);
                if (ec) {
                    throw std::runtime_error("Unable to create SQLite database directory: " + ec.message());
                }
            }
        }
        if (sqlite3_open(path.c_str(), &db_) != SQLITE_OK) {
            throw std::runtime_error("Unable to open SQLite database at " + path);
        }
        sqlite3_exec(db_, "PRAGMA foreign_keys = ON;", nullptr, nullptr, nullptr);
        Logger::instance().info("Connected to SQLite database: " + path);
    }

    ~DatabaseManager() { if (db_) sqlite3_close(db_); }

    DatabaseManager(const DatabaseManager&) = delete;
    DatabaseManager& operator=(const DatabaseManager&) = delete;

    std::unique_ptr<SqliteStatement> prepare(const std::string& sql) {
        return std::make_unique<SqliteStatement>(db_, sql);
    }

    void exec(const std::string& sql) {
        char* errMsg = nullptr;
        if (sqlite3_exec(db_, sql.c_str(), nullptr, nullptr, &errMsg) != SQLITE_OK) {
            std::string message = errMsg ? errMsg : "unknown error";
            sqlite3_free(errMsg);
            throw std::runtime_error("SQL execution failed: " + message);
        }
    }

    void migrate() {
        exec(R"sql(
            CREATE TABLE IF NOT EXISTS users (
                id TEXT PRIMARY KEY,
                name TEXT NOT NULL,
                email TEXT UNIQUE NOT NULL,
                password_hash TEXT NOT NULL,
                created_at TEXT NOT NULL,
                updated_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS sessions (
                token TEXT PRIMARY KEY,
                user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
                expires_at TEXT NOT NULL,
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS transcripts (
                id TEXT PRIMARY KEY,
                user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
                title TEXT NOT NULL,
                content TEXT NOT NULL,
                language TEXT NOT NULL,
                type TEXT NOT NULL DEFAULT 'voice_to_text',
                source_audio TEXT,
                duration INTEGER,
                favorite INTEGER NOT NULL DEFAULT 0,
                status TEXT NOT NULL DEFAULT 'completed',
                created_at TEXT NOT NULL,
                updated_at TEXT NOT NULL
            );
            CREATE INDEX IF NOT EXISTS idx_transcripts_user ON transcripts(user_id);
            CREATE INDEX IF NOT EXISTS idx_transcripts_title ON transcripts(title);

            CREATE TABLE IF NOT EXISTS audio_files (
                id TEXT PRIMARY KEY,
                user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
                filename TEXT NOT NULL,
                filepath TEXT NOT NULL,
                mime_type TEXT NOT NULL,
                duration INTEGER,
                file_size INTEGER NOT NULL,
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS tts_generations (
                id TEXT PRIMARY KEY,
                user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
                text TEXT NOT NULL,
                language TEXT NOT NULL,
                voice TEXT NOT NULL,
                speed REAL NOT NULL DEFAULT 1.0,
                audio_path TEXT,
                favorite INTEGER NOT NULL DEFAULT 0,
                status TEXT NOT NULL DEFAULT 'completed',
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS ai_operations (
                id TEXT PRIMARY KEY,
                user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
                transcript_id TEXT REFERENCES transcripts(id) ON DELETE SET NULL,
                operation TEXT NOT NULL,
                input_text TEXT NOT NULL,
                output_text TEXT NOT NULL,
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS languages (
                code TEXT PRIMARY KEY,
                label TEXT NOT NULL,
                speech_code TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS user_settings (
                user_id TEXT PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
                theme TEXT NOT NULL DEFAULT 'light',
                default_language TEXT NOT NULL DEFAULT 'en',
                default_voice TEXT NOT NULL DEFAULT 'default-female',
                default_speed REAL NOT NULL DEFAULT 1.0,
                auto_save INTEGER NOT NULL DEFAULT 1,
                audio_retention_days INTEGER NOT NULL DEFAULT 30,
                notifications INTEGER NOT NULL DEFAULT 1,
                share_with_providers INTEGER NOT NULL DEFAULT 0
            );
            CREATE TABLE IF NOT EXISTS favorites (
                id TEXT PRIMARY KEY,
                user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
                document_id TEXT NOT NULL,
                document_type TEXT NOT NULL,
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS activity_logs (
                id TEXT PRIMARY KEY,
                user_id TEXT REFERENCES users(id) ON DELETE SET NULL,
                action TEXT NOT NULL,
                created_at TEXT NOT NULL
            );
        )sql");
        Logger::instance().info("Database schema migrated successfully");
    }

private:
    sqlite3* db_ = nullptr;
};

} // namespace voicetext
