      const recycling_allocator<U>&) ASIO_NOEXCEPT
  {
  }

  /// Equality operator. Always returns true.
  ASIO_CONSTEXPR bool operator==(
      const recycling_allocator&) const ASIO_NOEXCEPT
  {
    return true;
  }

  /// Inequality operator. Always returns false.
  ASIO_CONSTEXPR bool operator!=(
