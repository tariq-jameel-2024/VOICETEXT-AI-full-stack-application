#pragma once
// Abstraction layer for speech-to-text engines. Real providers (e.g. a local
// Whisper.cpp model, or a cloud STT API) implement this interface; the rest
// of the application never depends on a concrete provider.

#include <memory>
#include <string>

#include "models/Models.hpp"
#include "utils/ConfigManager.hpp"
#include "utils/Logger.hpp"

namespace voicetext {

class SpeechToTextProvider {
public:
    virtual ~SpeechToTextProvider() = default;

    // audioFile is a server-side path inside storage/audio/uploads (already
    // validated by FileManager). language is a BCP-47-ish code (e.g. "en-US").
    virtual TranscriptResult transcribe(const std::string& audioFile, const std::string& language) = 0;

    virtual std::string providerName() const = 0;
};

// Demo/mock provider — used automatically when STT_PROVIDER is unset so the
// application remains fully functional without external credentials.
// Clearly marks output as demo data; never claims to be a real transcription.
class MockSpeechToTextProvider : public SpeechToTextProvider {
public:
    TranscriptResult transcribe(const std::string& audioFile, const std::string& language) override {
        Logger::instance().info("MockSTTProvider: simulating transcription for " + audioFile);
        TranscriptResult result;
        result.success = true;
        result.isDemo = true;
        result.language = language;
        result.confidence = 0.0;
        result.text = "[DEMO TRANSCRIPTION] No real STT_PROVIDER configured. This is simulated output "
                      "standing in for file '" + audioFile + "'. Configure STT_PROVIDER / STT_API_KEY in "
                      "config/.env to enable real transcription.";
        return result;
    }

    std::string providerName() const override { return "mock"; }
};

// Factory: builds the configured provider, falling back to the mock
// implementation automatically (never crashes the server for missing creds).
inline std::unique_ptr<SpeechToTextProvider> createSpeechToTextProvider(const ConfigManager& config) {
    std::string provider = config.get("STT_PROVIDER");
    if (provider.empty()) {
        Logger::instance().warning("STT_PROVIDER not configured — using demo/mock STT provider");
        return std::make_unique<MockSpeechToTextProvider>();
    }
    // Real integrations (e.g. WhisperCppProvider, CloudSttProvider) would be
    // instantiated here based on `provider`. Left as an extension point.
    Logger::instance().warning("STT provider '" + provider + "' is not yet implemented — falling back to demo mode");
    return std::make_unique<MockSpeechToTextProvider>();
}

} // namespace voicetext
</file>

