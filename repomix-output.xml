<file path="build-ucrt/_deps/ex-standaloneasio-populate1234/asio-asio-1-28-2/asio/src/examples/cpp03/services/logger_service.hpp">
//
// logger_service.hpp
// ~~~~~~~~~~~~~~~~~~
//
