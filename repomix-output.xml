      impl_(ASIO_MOVE_CAST(Impl)(other.impl_)),
      work_(ASIO_MOVE_CAST(Work)(other.work_)),
      handler_(ASIO_MOVE_CAST(Handler)(other.handler_)),
      invocations_(other.invocations_)
  {
  }
#endif // defined(ASIO_HAS_MOVE)

