struct composed_io_executors<void(Head, ASIO_VARIADIC_TARGS(n))> \
{ \
  explicit composed_io_executors(const Head& head, \
      ASIO_VARIADIC_CONSTREF_PARAMS(n)) ASIO_NOEXCEPT \
    : head_(head), \
