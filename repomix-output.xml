<file path="src/pages/Profile.tsx">
import { useState } from "react";
import { User as UserIcon, Mail, Lock, Trash2, Save } from "lucide-react";
import { Layout } from "../components/Layout";
import { Card, Button, Input } from "../components/ui";
import { useAuth } from "../context/AuthContext";
import { useToast } from "../context/ToastContext";
import { authApi } from "../lib/api";
import { useNavigate } from "react-router-dom";

export default function Profile() {
  const { user, refreshUser, logout } = useAuth();
  const { push } = useToast();
  const navigate = useNavigate();
  const [name, setName] = useState(user?.name ?? "");
  const [savingProfile, setSavingProfile] = useState(false);

  const [currentPw, setCurrentPw] = useState("");
  const [newPw, setNewPw] = useState("");
  const [savingPw, setSavingPw] = useState(false);
  const [confirmDelete, setConfirmDelete] = useState(false);

  async function saveProfile() {
    setSavingProfile(true);
    const res = await authApi.updateProfile(name);
    setSavingProfile(false);
    if (res.success) {
      await refreshUser();
      push("Profile updated", "success");
    } else push(res.message, "error");
  }

  async function changePassword() {
    if (newPw.length < 6) {
      push("New password must be at least 6 characters", "warning");
      return;
    }
    setSavingPw(true);
    const res = await authApi.changePassword(currentPw, newPw);
    setSavingPw(false);
    if (res.success) {
      push("Password updated successfully", "success");
      setCurrentPw("");
      setNewPw("");
    } else push(res.message, "error");
  }

  async function deleteAccount() {
    await authApi.deleteAccount();
    push("Account deleted", "info");
    await logout();
    navigate("/login");
  }

  return (
    <Layout title="Profile">
      <div className="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <Card className="p-6">
          <div className="mb-5 flex items-center gap-4">
            <div className="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 text-2xl font-bold text-white">
              {user?.name?.[0]?.toUpperCase() ?? "U"}
            </div>
            <div>
              <p className="text-lg font-semibold text-slate-900 dark:text-white">{user?.name}</p>
              <p className="text-sm text-slate-500 dark:text-slate-400">{user?.email}</p>
            </div>
          </div>
          <div className="space-y-4">
            <div>
              <label className="mb-1.5 flex items-center gap-1.5 text-sm font-medium text-slate-700 dark:text-slate-300">
                <UserIcon className="h-3.5 w-3.5" /> Full Name
              </label>
              <Input value={name} onChange={(e) => setName(e.target.value)} />
            </div>
            <div>
              <label className="mb-1.5 flex items-center gap-1.5 text-sm font-medium text-slate-700 dark:text-slate-300">
                <Mail className="h-3.5 w-3.5" /> Email Address
              </label>
              <Input value={user?.email ?? ""} disabled className="opacity-60" />
            </div>
            <Button onClick={saveProfile} disabled={savingProfile} icon={<Save className="h-4 w-4" />}>
              Save Changes
            </Button>
          </div>
        </Card>

        <div className="space-y-6">
          <Card className="p-6">
            <h3 className="mb-4 flex items-center gap-2 font-semibold text-slate-900 dark:text-white">
              <Lock className="h-4 w-4" /> Change Password
            </h3>
            <div className="space-y-3">
              <Input type="password" placeholder="Current password" value={currentPw} onChange={(e) => setCurrentPw(e.target.value)} />
              <Input type="password" placeholder="New password (6+ characters)" value={newPw} onChange={(e) => setNewPw(e.target.value)} />
              <Button onClick={changePassword} disabled={savingPw} variant="secondary">
                Update Password
              </Button>
            </div>
          </Card>

          <Card className="border-rose-200 p-6 dark:border-rose-500/30">
            <h3 className="mb-2 flex items-center gap-2 font-semibold text-rose-600">
              <Trash2 className="h-4 w-4" /> Danger Zone
            </h3>
            <p className="mb-4 text-sm text-slate-500 dark:text-slate-400">
              Permanently delete your account and all associated transcripts, audio, and settings. This cannot be undone.
            </p>
            {!confirmDelete ? (
              <Button variant="danger" onClick={() => setConfirmDelete(true)}>
                Delete Account
              </Button>
            ) : (
              <div className="flex gap-2">
                <Button variant="danger" onClick={deleteAccount}>
                  Confirm Delete
                </Button>
                <Button variant="outline" onClick={() => setConfirmDelete(false)}>
                  Cancel
                </Button>
              </div>
            )}
          </Card>
        </div>
      </div>
    </Layout>
  );
}
</file>

<file path="src/pages/Register.tsx">
import { useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { AudioLines, Eye, EyeOff } from "lucide-react";
import { useAuth } from "../context/AuthContext";
import { useToast } from "../context/ToastContext";
import { Button, Input, Spinner } from "../components/ui";
import { AuthShell } from "./Login";

export default function Register() {
  const { register } = useAuth();
  const { push } = useToast();
  const navigate = useNavigate();
  const [name, setName] = useState("");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [showPw, setShowPw] = useState(false);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const submit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError("");
    setLoading(true);
    const res = await register(name, email, password);
    setLoading(false);
    if (res.success) {
      push("Account created — welcome to VoiceText AI!", "success");
      navigate("/dashboard");
    } else {
      setError(res.message);
    }
  };

  return (
    <AuthShell>
      <div className="mb-8">
        <div className="mb-4 flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 to-violet-600 text-white shadow-lg shadow-indigo-500/30">
          <AudioLines className="h-6 w-6" />
        </div>
        <h1 className="text-2xl font-bold text-slate-900 dark:text-white">Create your account</h1>
        <p className="mt-1 text-sm text-slate-500 dark:text-slate-400">Start transcribing and generating speech in minutes.</p>
      </div>

      <form onSubmit={submit} className="space-y-4">
        <div>
          <label className="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Full name</label>
          <Input required value={name} onChange={(e) => setName(e.target.value)} placeholder="Jane Doe" />
        </div>
        <div>
          <label className="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Email address</label>
          <Input type="email" required value={email} onChange={(e) => setEmail(e.target.value)} placeholder="you@company.com" />
        </div>
        <div>
          <label className="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Password</label>
          <div className="relative">
            <Input type={showPw ? "text" : "password"} required minLength={6} value={password} onChange={(e) => setPassword(e.target.value)} placeholder="At least 6 characters" />
            <button type="button" onClick={() => setShowPw((s) => !s)} className="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">
              {showPw ? <EyeOff className="h-4 w-4" /> : <Eye className="h-4 w-4" />}
            </button>
          </div>
        </div>

        {error && <p className="rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600 dark:bg-rose-500/10">{error}</p>}

        <Button type="submit" disabled={loading} className="w-full justify-center">
          {loading ? <Spinner /> : "Create Account"}
        </Button>
      </form>

      <p className="mt-6 text-center text-sm text-slate-500 dark:text-slate-400">
        Already registered?{" "}
        <Link to="/login" className="font-semibold text-indigo-600 hover:underline dark:text-indigo-400">
          Sign in
        </Link>
      </p>
      <p className="mt-4 text-center text-xs text-slate-400">
        Passwords are securely hashed by the C++ backend when connected. Offline demo data stays in this browser.
      </p>
    </AuthShell>
  );
}
</file>

<file path="src/pages/Settings.tsx">
import { useEffect, useState } from "react";
import { Save, Moon, Sun, ShieldCheck, Bell, Database, Languages as LangIcon } from "lucide-react";
import { Layout } from "../components/Layout";
import { Card, Button, Select } from "../components/ui";
import { useAuth } from "../context/AuthContext";
import { useTheme } from "../context/ThemeContext";
import { useToast } from "../context/ToastContext";
import { settingsApi } from "../lib/api";
import { DEFAULT_SETTINGS } from "../lib/storage";
import type { UserSettings } from "../types";
import { LANGUAGES, VOICES } from "../lib/languages";

export default function Settings() {
  const { user } = useAuth();
  const { theme, setTheme } = useTheme();
  const { push } = useToast();
  const [settings, setSettings] = useState<UserSettings>(DEFAULT_SETTINGS);
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    if (!user) return;
    settingsApi.get(user.id).then((res) => res.data && setSettings({ ...res.data, theme }));
  }, [user]);

  function update<K extends keyof UserSettings>(key: K, value: UserSettings[K]) {
    setSettings((s) => ({ ...s, [key]: value }));
  }

  async function save() {
    if (!user) return;
    setSaving(true);
    setTheme(settings.theme);
    const res = await settingsApi.update(user.id, settings);
    setSaving(false);
    if (res.success) push("Settings saved successfully", "success");
    else push(res.message, "error");
  }

  return (
    <Layout title="Settings">
      <div className="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <Card className="p-6">
          <h3 className="mb-4 flex items-center gap-2 font-semibold text-slate-900 dark:text-white">
            <Sun className="h-4 w-4" /> Appearance &amp; Language
          </h3>
          <div className="space-y-4">
            <Field label="Theme">
              <div className="flex gap-2">
                <ThemeBtn active={settings.theme === "light"} onClick={() => update("theme", "light")} icon={<Sun className="h-4 w-4" />} label="Light" />
                <ThemeBtn active={settings.theme === "dark"} onClick={() => update("theme", "dark")} icon={<Moon className="h-4 w-4" />} label="Dark" />
              </div>
            </Field>
            <Field label="Default interface language">
              <Select value={settings.defaultLanguage} onChange={(e) => update("defaultLanguage", e.target.value)}>
                {LANGUAGES.map((l) => (
                  <option key={l.code} value={l.code}>
                    {l.flag} {l.label}
                  </option>
                ))}
              </Select>
            </Field>
            <Field label="Default TTS voice">
              <Select value={settings.defaultVoice} onChange={(e) => update("defaultVoice", e.target.value)}>
                {VOICES.map((v) => (
                  <option key={v.id} value={v.id}>
                    {v.label}
                  </option>
                ))}
              </Select>
            </Field>
            <Field label={`Default speech speed: ${settings.defaultSpeed.toFixed(1)}x`}>
              <input
                type="range"
                min={0.5}
                max={2}
                step={0.1}
                value={settings.defaultSpeed}
                onChange={(e) => update("defaultSpeed", parseFloat(e.target.value))}
                className="w-full accent-indigo-600"
              />
            </Field>
          </div>
        </Card>

        <Card className="p-6">
          <h3 className="mb-4 flex items-center gap-2 font-semibold text-slate-900 dark:text-white">
            <Database className="h-4 w-4" /> Documents &amp; Storage
          </h3>
          <div className="space-y-4">
            <ToggleRow
              label="Auto-save transcripts"
              description="Automatically save changes while editing documents."
              checked={settings.autoSave}
              onChange={(v) => update("autoSave", v)}
            />
            <Field label={`Audio retention: ${settings.audioRetentionDays} days`}>
              <input
                type="range"
                min={1}
                max={90}
                value={settings.audioRetentionDays}
                onChange={(e) => update("audioRetentionDays", parseInt(e.target.value))}
                className="w-full accent-indigo-600"
              />
              <p className="mt-1 text-xs text-slate-400">Audio recordings older than this are automatically purged. Transcripts are kept independently.</p>
            </Field>
          </div>
        </Card>

        <Card className="p-6">
          <h3 className="mb-4 flex items-center gap-2 font-semibold text-slate-900 dark:text-white">
            <Bell className="h-4 w-4" /> Notifications
          </h3>
          <ToggleRow
            label="Enable notifications"
            description="Get notified when long transcriptions or AI tasks complete."
            checked={settings.notifications}
            onChange={(v) => update("notifications", v)}
          />
        </Card>

        <Card className="p-6">
          <h3 className="mb-4 flex items-center gap-2 font-semibold text-slate-900 dark:text-white">
            <ShieldCheck className="h-4 w-4" /> Privacy
          </h3>
          <ToggleRow
            label="Allow sharing with external AI/STT/TTS providers"
            description="When enabled, text/audio may be sent to third-party providers configured on the backend. Provider availability depends on server configuration."
            checked={settings.shareWithProviders}
            onChange={(v) => update("shareWithProviders", v)}
          />
          <p className="mt-3 rounded-lg bg-slate-50 p-3 text-xs text-slate-500 dark:bg-slate-800 dark:text-slate-400">
            <LangIcon className="mr-1 inline h-3.5 w-3.5" />
            You can delete individual audio files independently from their transcripts at any time from the Transcripts or History pages.
          </p>
        </Card>
      </div>

      <div className="mt-6 flex justify-end">
        <Button onClick={save} disabled={saving} icon={<Save className="h-4 w-4" />}>
          {saving ? "Saving…" : "Save Settings"}
        </Button>
      </div>
    </Layout>
  );
}

function Field({ label, children }: { label: string; children: React.ReactNode }) {
  return (
    <div>
      <label className="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">{label}</label>
      {children}
    </div>
  );
}

function ThemeBtn({ active, onClick, icon, label }: { active: boolean; onClick: () => void; icon: React.ReactNode; label: string }) {
  return (
    <button
      onClick={onClick}
      className={`flex flex-1 items-center justify-center gap-2 rounded-xl border px-3 py-2.5 text-sm font-medium transition ${
        active ? "border-indigo-500 bg-indigo-50 text-indigo-700 dark:bg-indigo-500/10 dark:text-indigo-300" : "border-slate-200 text-slate-500 dark:border-slate-700"
      }`}
    >
      {icon} {label}
    </button>
  );
}

function ToggleRow({ label, description, checked, onChange }: { label: string; description: string; checked: boolean; onChange: (v: boolean) => void }) {
  return (
    <div className="flex items-start justify-between gap-4">
      <div>
        <p className="text-sm font-medium text-slate-700 dark:text-slate-200">{label}</p>
        <p className="text-xs text-slate-400">{description}</p>
      </div>
      <button
        onClick={() => onChange(!checked)}
        className={`relative h-6 w-11 shrink-0 rounded-full transition ${checked ? "bg-indigo-600" : "bg-slate-300 dark:bg-slate-700"}`}
      >
        <span className={`absolute top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform ${checked ? "translate-x-5" : "translate-x-0.5"}`} />
      </button>
    </div>
  );
}
</file>

<file path="src/pages/TextToVoice.tsx">
import { useEffect, useMemo, useState } from "react";
import { Volume2, Play, Pause, Square, Download, Save, Trash2, Languages, Gauge, Mic2, Star } from "lucide-react";
import { Layout } from "../components/Layout";
import { Card, Button, Select, Textarea, Badge, EmptyState } from "../components/ui";
import { Waveform } from "../components/AgentAnimations";
import { LANGUAGES, voicesForLanguage } from "../lib/languages";
import { getBrowserVoices, isSpeechSynthesisSupported, pauseSpeech, resumeSpeech, speak, cancelSpeech, createSynthesizedWavBlob } from "../lib/speech";
import { useAuth } from "../context/AuthContext";
import { useToast } from "../context/ToastContext";
import { ttsApi } from "../lib/api";
import type { TTSGeneration } from "../types";

type PlayState = "idle" | "speaking" | "paused";

export default function TextToVoice() {
  const { user } = useAuth();
  const { push } = useToast();
  const [text, setText] = useState("Welcome to VoiceText AI — type anything and hear it come to life.");
  const [language, setLanguage] = useState("en");
  const [voice, setVoice] = useState(voicesForLanguage("en")[0]?.id || "");
  const [speed, setSpeed] = useState(1);
  const [playState, setPlayState] = useState<PlayState>("idle");
  const [generating, setGenerating] = useState(false);
  const [items, setItems] = useState<TTSGeneration[]>([]);
  const supported = isSpeechSynthesisSupported();

  useEffect(() => {
    if (!user) return;
    ttsApi.list(user.id).then((res) => setItems(res.data ?? []));
  }, [user]);

  useEffect(() => {
    // preload available voices (required on some browsers)
    if (supported) window.speechSynthesis.getVoices();
  }, [supported]);

  const voiceOptions = useMemo(() => voicesForLanguage(language), [language]);
  const langMeta = LANGUAGES.find((l) => l.code === language)!;

  function handleGenerate() {
    if (!text.trim()) {
      push("Please enter text before generating speech.", "warning");
      return;
    }
    if (!supported) {
      push("Speech synthesis isn't supported in this browser.", "error");
      return;
    }
    setGenerating(true);
    const browserVoices = getBrowserVoices().filter((v) => v.lang.startsWith(langMeta.speechCode.split("-")[0]));
    const chosen = browserVoices[0];
    setTimeout(() => {
      setGenerating(false);
      setPlayState("speaking");
      speak(text, {
        lang: langMeta.speechCode,
        voiceURI: chosen?.voiceURI,
        rate: speed,
        onEnd: () => setPlayState("idle"),
        onStart: () => setPlayState("speaking"),
      });
      push("Speech generated and playing", "success");
    }, 500);
  }

  function handlePause() {
    pauseSpeech();
    setPlayState("paused");
  }
  function handleResume() {
    resumeSpeech();
    setPlayState("speaking");
  }
  function handleStop() {
    cancelSpeech();
    setPlayState("idle");
  }

  async function handleSave() {
    if (!user) return;
    const res = await ttsApi.generate(user.id, text, language, voice, speed);
    if (res.success && res.data) {
      setItems((prev) => [res.data!, ...prev]);
      push("Voice generation saved to history", "success");
    } else {
      push(res.message, "error");
    }
  }

  async function handleDelete(id: string) {
    await ttsApi.remove(id);
    setItems((prev) => prev.filter((i) => i.id !== id));
    push("Audio deleted", "info");
  }

  async function handleToggleFavorite(item: TTSGeneration) {
    const next = !item.favorite;
    const res = await ttsApi.toggleFavorite(item.id, next);
    if (res.success) {
      setItems((prev) => prev.map((i) => (i.id === item.id ? { ...i, favorite: next } : i)));
      push(res.message, "success");
    } else {
      push(res.message, "error");
    }
  }

  function handleDownloadAudio() {
    if (!text.trim()) {
      push("Please enter text first before downloading audio.", "warning");
      return;
    }
    const wavBlob = createSynthesizedWavBlob(text, speed);
    const url = URL.createObjectURL(wavBlob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `voice-${language}-${Date.now()}.wav`;
    a.click();
    URL.revokeObjectURL(url);
    push("Audio file downloaded successfully (.wav)", "success");
  }

  return (
    <Layout title="Text to Voice">
      <div className="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <Card className="p-6 lg:col-span-2">
          <div className="mb-3 flex items-center justify-between">
            <h3 className="font-semibold text-slate-900 dark:text-white">Enter your text</h3>
            <span className="text-xs text-slate-400">{text.length}/5000</span>
          </div>
          <Textarea value={text} onChange={(e) => setText(e.target.value.slice(0, 5000))} rows={9} placeholder="Type or paste the text you want to convert to speech…" />

          <div className="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label className="mb-1.5 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">
                <Languages className="h-3.5 w-3.5" /> Language
              </label>
              <Select
                value={language}
                onChange={(e) => {
                  setLanguage(e.target.value);
                  setVoice(voicesForLanguage(e.target.value)[0]?.id ?? "");
                }}
              >
                {LANGUAGES.map((l) => (
                  <option key={l.code} value={l.code}>
                    {l.flag} {l.label}
                  </option>
                ))}
              </Select>
            </div>
            <div>
              <label className="mb-1.5 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">
                <Mic2 className="h-3.5 w-3.5" /> Voice
              </label>
              <Select value={voice} onChange={(e) => setVoice(e.target.value)}>
                {voiceOptions.map((v) => (
                  <option key={v.id} value={v.id}>
                    {v.label}
                  </option>
                ))}
              </Select>
            </div>
            <div>
              <label className="mb-1.5 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">
                <Gauge className="h-3.5 w-3.5" /> Speed: {speed.toFixed(1)}x
              </label>
              <input
                type="range"
                min={0.5}
                max={2}
                step={0.1}
                value={speed}
                onChange={(e) => setSpeed(parseFloat(e.target.value))}
                className="mt-3 w-full accent-indigo-600"
              />
            </div>
          </div>

          <Button className="mt-5 w-full justify-center sm:w-auto" onClick={handleGenerate} disabled={generating} icon={<Volume2 className="h-4 w-4" />}>
            {generating ? "Generating…" : "Generate Voice"}
          </Button>

          <div className="mt-6 rounded-2xl border border-slate-100 p-5 dark:border-slate-800">
            <p className="mb-3 text-sm font-medium text-slate-600 dark:text-slate-300">Audio Player</p>
            <Waveform active={playState === "speaking"} />
            <div className="mt-4 flex flex-wrap items-center gap-2">
              {playState === "idle" && (
                <Button size="sm" onClick={handleGenerate} icon={<Play className="h-4 w-4" />}>
                  Play
                </Button>
              )}
              {playState === "speaking" && (
                <Button size="sm" variant="secondary" onClick={handlePause} icon={<Pause className="h-4 w-4" />}>
                  Pause
                </Button>
              )}
              {playState === "paused" && (
                <Button size="sm" onClick={handleResume} icon={<Play className="h-4 w-4" />}>
                  Resume
                </Button>
              )}
              <Button size="sm" variant="outline" onClick={handleStop} icon={<Square className="h-4 w-4" />}>
                Stop
              </Button>
              <Button size="sm" variant="outline" onClick={handleDownloadAudio} icon={<Download className="h-4 w-4" />}>
                Download WAV
              </Button>
              <Button size="sm" variant="secondary" onClick={handleSave} icon={<Save className="h-4 w-4" />}>
                Save
              </Button>
            </div>
            {!supported && <p className="mt-3 text-xs text-amber-600">Speech synthesis isn't supported in this browser.</p>}
          </div>
        </Card>

        <Card className="p-6">
          <h3 className="mb-4 font-semibold text-slate-900 dark:text-white">Saved Voice Generations</h3>
          {items.length === 0 ? (
            <EmptyState icon={<Volume2 className="h-6 w-6" />} title="No saved audio yet" description="Generate and save speech to see it listed here." />
          ) : (
            <ul className="space-y-3">
              {items.map((item) => (
                <li key={item.id} className="rounded-xl border border-slate-100 p-3 dark:border-slate-800">
                  <p className="line-clamp-2 text-sm text-slate-700 dark:text-slate-200">{item.text}</p>
                  <div className="mt-2 flex items-center justify-between">
                    <Badge tone="slate">
                      {LANGUAGES.find((l) => l.code === item.language)?.flag} {item.voice} · {item.speed}x
                    </Badge>
                    <div className="flex items-center gap-1">
                      <button
                        onClick={() => handleToggleFavorite(item)}
                        className="rounded p-1 hover:bg-slate-100 dark:hover:bg-slate-700"
                        title={item.favorite ? "Unfavorite" : "Favorite"}
                      >
                        <Star className={`h-3.5 w-3.5 ${item.favorite ? "fill-amber-400 text-amber-400" : "text-slate-300"}`} />
                      </button>
                      <Button
                        variant="ghost"
                        size="sm"
                        onClick={() => {
                          setText(item.text);
                          setLanguage(item.language);
                          setVoice(item.voice);
                          setSpeed(item.speed);
                        }}
                      >
                        <Play className="h-3.5 w-3.5" />
                      </Button>
                      <Button variant="ghost" size="sm" onClick={() => handleDelete(item.id)}>
                        <Trash2 className="h-3.5 w-3.5 text-rose-500" />
                      </Button>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </Card>
      </div>
    </Layout>
  );
}
