{
public:
  typedef handler_work<Handler, IoExecutor> handler_work_type;

  explicit immediate_handler_work(ASIO_MOVE_ARG(handler_work_type) w)
    : handler_work_(ASIO_MOVE_CAST(handler_work_type)(w))
  {
