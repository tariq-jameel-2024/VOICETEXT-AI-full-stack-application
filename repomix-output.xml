  {
    switch (state_)
    {
    case starting:
      state_ = posting;
      asio::post(ioc_, ASIO_MOVE_CAST(Self)(self));
      break;
    case posting:
      self.complete(42);
      break;
    default:
      break;
    }
  }

private:
  asio::io_context& ioc_;
  enum { starting, posting } state_;
};

