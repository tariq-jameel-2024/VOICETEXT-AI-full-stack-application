/// Wait until an operation completes, then cancel the others.
class wait_for_one
{
public:
  ASIO_CONSTEXPR explicit wait_for_one(
      cancellation_type_t cancel_type = cancellation_type::all)
    : cancel_type_(cancel_type)
  {
