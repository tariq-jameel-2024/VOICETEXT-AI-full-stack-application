     template <> struct is_match_condition<match_char>
       : public boost::true_type {};
   } // namespace asio
   ...
   void handler(const asio::error_code& e, std::size_t size);
   ...
   std::string data;
   asio::async_read_until(s, data, match_char('a'), handler);





