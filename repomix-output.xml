#endif // !defined(ASIO_NO_DYNAMIC_BUFFER_V1)
    vector_.erase(vector_.begin(), vector_.begin() + (std::min)(size(), n));
  }

private:
  std::vector<Elem, Allocator>& vector_;
#if !defined(ASIO_NO_DYNAMIC_BUFFER_V1)
  std::size_t size_;
#endif // !defined(ASIO_NO_DYNAMIC_BUFFER_V1)
  const std::size_t max_size_;
