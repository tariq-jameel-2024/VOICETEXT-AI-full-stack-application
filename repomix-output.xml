    )
    if(error_code)
      # Stash pop failed: Restore previous state.
      execute_process(
        COMMAND "C:/Program Files/Git/cmd/git.exe" --git-dir=.git reset --hard --quiet ${head_sha}
        WORKING_DIRECTORY "C:/Users/PC vision/OneDrive/Documents/VOICETEXT-AI-full-stack-application/build-ucrt/_deps/crow-src"
        ${maybe_show_command}
      )
      execute_process(
        COMMAND "C:/Program Files/Git/cmd/git.exe" --git-dir=.git stash pop --index --quiet
        WORKING_DIRECTORY "C:/Users/PC vision/OneDrive/Documents/VOICETEXT-AI-full-stack-application/build-ucrt/_deps/crow-src"
        ${maybe_show_command}
      )
      message(FATAL_ERROR "\nFailed to unstash changes in: 'C:/Users/PC vision/OneDrive/Documents/VOICETEXT-AI-full-stack-application/build-ucrt/_deps/crow-src'."
                          "\nYou will have to resolve the conflicts manually")
