<file path="backend/include/utils/FileManager.hpp">
#pragma once
// Secure file storage helper: generates unguessable filenames, validates
// extensions/size, and prevents path traversal outside the storage root.

#include <algorithm>
#include <filesystem>
#include <fstream>
#include <random>
#include <sstream>
#include <string>
#include <vector>

#include "utils/Http.hpp"

namespace fs = std::filesystem;

namespace voicetext {

class FileManager {
public:
    explicit FileManager(std::string root) : root_(std::move(root)) {
        fs::create_directories(root_ + "/audio/uploads");
        fs::create_directories(root_ + "/audio/generated");
        fs::create_directories(root_ + "/transcripts");
        fs::create_directories(root_ + "/exports");
    }

    // Generates a cryptographically-random, collision-resistant filename.
    // User-supplied filenames are NEVER trusted directly.
    static std::string generateSafeFilename(const std::string& extension) {
        static const char charset[] = "abcdefghijklmnopqrstuvwxyz0123456789";
        std::random_device rd;
        std::mt19937 gen(rd());
        std::uniform_int_distribution<> dist(0, sizeof(charset) - 2);
        std::ostringstream oss;
        for (int i = 0; i < 24; ++i) oss << charset[dist(gen)];
        return oss.str() + "." + sanitizeExtension(extension);
    }

    bool saveBinary(const std::string& relativeDir, const std::string& filename, const std::string& bytes, size_t maxBytes) {
        if (bytes.size() > maxBytes) return false;
        if (!Validator::isSafeFilename(filename)) return false;
        fs::path target = resolveSafePath(relativeDir, filename);
        std::ofstream out(target, std::ios::binary);
        if (!out) return false;
        out.write(bytes.data(), static_cast<std::streamsize>(bytes.size()));
        return true;
    }

    bool remove(const std::string& relativeDir, const std::string& filename) {
        if (!Validator::isSafeFilename(filename)) return false;
        std::error_code ec;
        return fs::remove(resolveSafePath(relativeDir, filename), ec);
    }

    std::string absolutePath(const std::string& relativeDir, const std::string& filename) const {
        return resolveSafePath(relativeDir, filename).string();
    }

private:
    std::string root_;

    static std::string sanitizeExtension(const std::string& ext) {
        std::string clean;
        for (char c : ext)
            if (std::isalnum(static_cast<unsigned char>(c))) clean += c;
        return clean.empty() ? "bin" : clean;
    }

    // Resolves a path inside root_ and throws/guards against traversal
    // (e.g. "../../etc/passwd") by validating the final canonical path is
    // still a descendant of the storage root.
    fs::path resolveSafePath(const std::string& relativeDir, const std::string& filename) const {
        fs::path base = fs::weakly_canonical(fs::path(root_) / relativeDir);
        fs::path candidate = fs::weakly_canonical(base / filename);
        auto baseStr = base.string();
        auto candidateStr = candidate.string();
        if (candidateStr.compare(0, baseStr.size(), baseStr) != 0) {
            throw std::runtime_error("Path traversal attempt blocked");
        }
        return candidate;
    }
};

} // namespace voicetext
</file>

<file path="backend/include/utils/Http.hpp">
#pragma once
// Consistent JSON API response envelope + lightweight input validators.

#include <nlohmann/json.hpp>
#include <regex>
#include <string>

namespace voicetext {

using Json = nlohmann::json;

class JsonResponse {
public:
    static Json ok(const Json& data = nullptr, const std::string& message = "Success") {
        Json j{{"success", true}, {"message", message}};
        if (!data.is_null()) j["data"] = data;
        return j;
    }

    static Json fail(const std::string& message, const std::string& errorCode = "ERROR") {
        return Json{{"success", false}, {"message", message}, {"error_code", errorCode}};
    }
};

class Validator {
public:
    static bool isValidEmail(const std::string& email) {
        static const std::regex pattern(R"((\w|\.|-)+@(\w|-)+\.[a-zA-Z]{2,})");
        return std::regex_match(email, pattern);
    }

    static bool isValidPassword(const std::string& password) {
        return password.size() >= 6 && password.size() <= 128;
    }

    static bool isNonEmpty(const std::string& value, size_t maxLen = 10000) {
        return !value.empty() && value.size() <= maxLen;
    }

    // Prevents path traversal in any user-supplied filename.
    static bool isSafeFilename(const std::string& filename) {
        if (filename.empty() || filename.size() > 255) return false;
        if (filename.find("..") != std::string::npos) return false;
        if (filename.find('/') != std::string::npos || filename.find('\\') != std::string::npos) return false;
        static const std::regex allowed(R"([A-Za-z0-9_\-. ]+)");
        return std::regex_match(filename, allowed);
    }

    static bool isAllowedAudioMime(const std::string& mime) {
        static const std::vector<std::string> allowed = {
            "audio/wav", "audio/x-wav", "audio/mpeg", "audio/mp3", "audio/webm", "audio/ogg", "audio/mp4"};
        for (const auto& m : allowed)
            if (m == mime) return true;
        return false;
    }
};

} // namespace voicetext
</file>

<file path="backend/include/utils/Logger.hpp">
#pragma once
// Structured logger used across every backend layer.
// Never logs passwords, API keys, tokens, or raw audio/transcript content.

#include <chrono>
#include <ctime>
#include <iomanip>
#include <iostream>
#include <mutex>
#include <sstream>
#include <string>

namespace voicetext {

enum class LogLevel { Info, Warning, Error, Security, Audit };

class Logger {
public:
    static Logger& instance() {
        static Logger logger;
        return logger;
    }

    void log(LogLevel level, const std::string& message) {
        std::lock_guard<std::mutex> lock(mutex_);
        std::cout << "[" << timestamp() << "] [" << levelLabel(level) << "] " << message << std::endl;
    }

    void info(const std::string& msg) { log(LogLevel::Info, msg); }
    void warning(const std::string& msg) { log(LogLevel::Warning, msg); }
    void error(const std::string& msg) { log(LogLevel::Error, msg); }
    void security(const std::string& msg) { log(LogLevel::Security, msg); }
    void audit(const std::string& msg) { log(LogLevel::Audit, msg); }

private:
    Logger() = default;
    std::mutex mutex_;

    static std::string levelLabel(LogLevel level) {
        switch (level) {
            case LogLevel::Info: return "INFO";
            case LogLevel::Warning: return "WARNING";
            case LogLevel::Error: return "ERROR";
            case LogLevel::Security: return "SECURITY";
            case LogLevel::Audit: return "AUDIT";
        }
        return "INFO";
    }

    static std::string timestamp() {
        auto now = std::chrono::system_clock::now();
        auto t = std::chrono::system_clock::to_time_t(now);
        std::ostringstream oss;
        oss << std::put_time(std::localtime(&t), "%Y-%m-%d %H:%M:%S");
        return oss.str();
    }
};

} // namespace voicetext
</file>

<file path="backend/include/utils/Security.hpp">
#pragma once
// Password hashing (PBKDF2-HMAC-SHA256 via OpenSSL) and signed session token
// helpers. Intentionally dependency-light so it can be swapped for
// bcrypt/argon2 in production without touching any calling code.

#include <openssl/evp.h>
#include <openssl/hmac.h>
#include <openssl/rand.h>

#include <chrono>
#include <iomanip>
#include <sstream>
#include <string>
#include <vector>

namespace voicetext {

class PasswordHasher {
public:
    static std::string hash(const std::string& password) {
        unsigned char salt[16];
        RAND_bytes(salt, sizeof(salt));
        unsigned char derived[32];
        PKCS5_PBKDF2_HMAC(password.c_str(), static_cast<int>(password.size()), salt, sizeof(salt), 100000, EVP_sha256(), sizeof(derived), derived);
        return toHex(salt, sizeof(salt)) + "$" + toHex(derived, sizeof(derived));
    }

    static bool verify(const std::string& password, const std::string& storedHash) {
        auto sep = storedHash.find('$');
        if (sep == std::string::npos) return false;
        auto salt = fromHex(storedHash.substr(0, sep));
        unsigned char derived[32];
        PKCS5_PBKDF2_HMAC(password.c_str(), static_cast<int>(password.size()), salt.data(), static_cast<int>(salt.size()), 100000, EVP_sha256(), sizeof(derived), derived);
        return toHex(derived, sizeof(derived)) == storedHash.substr(sep + 1);
    }

private:
    static std::string toHex(const unsigned char* data, size_t len) {
        std::ostringstream oss;
        for (size_t i = 0; i < len; ++i) oss << std::hex << std::setw(2) << std::setfill('0') << static_cast<int>(data[i]);
        return oss.str();
    }
    static std::vector<unsigned char> fromHex(const std::string& hex) {
        std::vector<unsigned char> out;
        try {
            for (size_t i = 0; i + 1 < hex.size(); i += 2)
                out.push_back(static_cast<unsigned char>(std::stoi(hex.substr(i, 2), nullptr, 16)));
        } catch (...) {
            return {};
        }
        return out;
    }
};

// Minimal signed session token: base64(payload).hmacHex(payload, secret)
// Payload = "<userId>:<expiryUnixSeconds>"
class SessionTokenManager {
public:
    explicit SessionTokenManager(std::string secret) : secret_(std::move(secret)) {}

    std::string issue(const std::string& userId, int ttlSeconds = 60 * 60 * 24 * 7) const {
        long expiry = static_cast<long>(std::time(nullptr)) + ttlSeconds;
        std::string payload = userId + ":" + std::to_string(expiry);
        return payload + "." + sign(payload);
    }

    // Returns the userId if the token is valid and not expired, else empty.
    std::string verify(const std::string& token) const {
        auto dot = token.find_last_of('.');
        if (dot == std::string::npos) return "";
        std::string payload = token.substr(0, dot);
        std::string signature = token.substr(dot + 1);
        if (sign(payload) != signature) return "";
        auto colon = payload.find(':');
        if (colon == std::string::npos) return "";
        long expiry = 0;
        try {
            expiry = std::stol(payload.substr(colon + 1));
        } catch (...) {
            return "";
        }
        if (expiry < static_cast<long>(std::time(nullptr))) return "";
        return payload.substr(0, colon);
    }

private:
    std::string secret_;

    std::string sign(const std::string& payload) const {
        unsigned char result[EVP_MAX_MD_SIZE];
        unsigned int len = 0;
        HMAC(EVP_sha256(), secret_.data(), static_cast<int>(secret_.size()),
             reinterpret_cast<const unsigned char*>(payload.data()), payload.size(), result, &len);
        std::ostringstream oss;
        for (unsigned int i = 0; i < len; ++i) oss << std::hex << std::setw(2) << std::setfill('0') << static_cast<int>(result[i]);
        return oss.str();
    }
};

} // namespace voicetext
</file>

<file path="backend/src/README.md">
# backend/src

VoiceText AI's backend is implemented as a **header-only** C++ library under
`backend/include/` (one class per file, organized by architectural layer:
`controllers/`, `services/`, `repositories/`, `models/`, `middleware/`,
`utils/`, `providers/`). This keeps the project easy to build with a single
`CMakeLists.txt` and no split header/implementation bookkeeping, while still
being fully modular — nothing lives in `main.cpp` beyond wiring.

This directory is kept so the build system has a stable `backend/src/*.cpp`
glob target for future non-header-only translation units (for example, a
real `WhisperCppSpeechToTextProvider.cpp` that links against a native
Whisper.cpp static library). Add new `.cpp` files here and they will be
picked up automatically by the root `CMakeLists.txt`.
</file>

<file path="backend/main.cpp">
// VoiceText AI — C++ backend entry point.
// Wires together configuration, the database, repositories, providers,
// services, middleware and controllers. Keeps main() thin by design —
// all real logic lives in backend/include and backend/src.

#include <crow.h>

#ifdef DELETE
#undef DELETE
#endif

#include <memory>

#include "controllers/AIController.hpp"
#include "controllers/AuthController.hpp"
#include "controllers/STTController.hpp"
#include "controllers/TTSController.hpp"
#include "controllers/TranscriptController.hpp"
#include "controllers/UserController.hpp"
#include "middleware/AuthMiddleware.hpp"
#include "providers/AITextService.hpp"
#include "providers/SpeechToTextProvider.hpp"
#include "providers/TextToSpeechProvider.hpp"
#include "repositories/MediaRepository.hpp"
#include "repositories/TranscriptRepository.hpp"
#include "repositories/UserRepository.hpp"
#include "services/AIService.hpp"
#include "services/AuthService.hpp"
#include "services/STTService.hpp"
#include "services/SettingsService.hpp"
#include "services/TTSService.hpp"
#include "services/TranscriptService.hpp"
