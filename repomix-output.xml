  /// Equality operator.
  friend constexpr bool operator==(
      const any_completion_handler& a, nullptr_t) ASIO_NOEXCEPT
  {
    return a.impl_ == nullptr;
  }

  /// Equality operator.
  friend constexpr bool operator==(
      nullptr_t, const any_completion_handler& b) ASIO_NOEXCEPT
  {
    return nullptr == b.impl_;
  }

  /// Inequality operator.
  friend constexpr bool operator!=(
      const any_completion_handler& a, nullptr_t) ASIO_NOEXCEPT
  {
    return a.impl_ != nullptr;
  }

  /// Inequality operator.
  friend constexpr bool operator!=(
      nullptr_t, const any_completion_handler& b) ASIO_NOEXCEPT
  {
    return nullptr != b.impl_;
  }
