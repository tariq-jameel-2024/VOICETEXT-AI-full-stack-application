#pragma once
#include <crow.h>

#include "middleware/AuthMiddleware.hpp"
#include "services/AuthService.hpp"
#include "utils/Http.hpp"
#include "utils/Logger.hpp"

namespace voicetext {

using CrowApp = crow::App<AuthMiddleware>;

inline void registerAuthRoutes(CrowApp& app, AuthService& authService) {
    CROW_ROUTE(app, "/api/auth/register").methods(crow::HTTPMethod::Post)([&authService](const crow::request& req) {
        auto body = Json::parse(req.body, nullptr, false);
        if (body.is_discarded()) return crow::response(400, JsonResponse::fail("Invalid JSON body", "VALIDATION_ERROR").dump());
        std::string name = body.value("name", "");
        std::string email = body.value("email", "");
        std::string password = body.value("password", "");
        Json result = authService.registerUser(name, email, password);
        return crow::response(result["success"] ? 201 : 400, result.dump());
    });

    CROW_ROUTE(app, "/api/auth/login").methods(crow::HTTPMethod::Post)([&authService](const crow::request& req) {
        auto body = Json::parse(req.body, nullptr, false);
        if (body.is_discarded()) return crow::response(400, JsonResponse::fail("Invalid JSON body", "VALIDATION_ERROR").dump());
        std::string email = body.value("email", "");
        std::string password = body.value("password", "");
        Json result = authService.login(email, password);
        return crow::response(result["success"] ? 200 : 401, result.dump());
    });

    CROW_ROUTE(app, "/api/auth/logout").methods(crow::HTTPMethod::Post)([]() {
        // Stateless tokens: logout is handled client-side by discarding the
        // token. A production deployment could additionally blacklist it in
        // the `sessions` table.
        return crow::response(200, JsonResponse::ok(nullptr, "Logged out").dump());
    });

    CROW_ROUTE(app, "/api/auth/me").methods(crow::HTTPMethod::Get)([&app, &authService](const crow::request& req) {
        auto& ctx = app.get_context<AuthMiddleware>(req);
        if (!ctx.authenticated) return crow::response(401, JsonResponse::fail("Session expired. Please log in again.", "NO_SESSION").dump());
        auto user = authService.authenticate(req.get_header_value("Authorization").substr(7));
        if (!user) return crow::response(401, JsonResponse::fail("Session expired", "NO_SESSION").dump());
        return crow::response(200, JsonResponse::ok(AuthService::userToJson(*user)).dump());
    });
}

} // namespace voicetext
</file>

<file path="backend/include/controllers/STTController.hpp">
#pragma once
#include <crow.h>

#include "controllers/AuthController.hpp"
#include "services/STTService.hpp"

namespace voicetext {

inline void registerSTTRoutes(CrowApp& app, STTService& service) {
    // multipart/form-data upload: fields `audio` (file) and `language` (text)
    CROW_ROUTE(app, "/api/stt/upload").methods(crow::HTTPMethod::Post)([&app, &service](const crow::request& req) {
        auto& ctx = app.get_context<AuthMiddleware>(req);
        if (!ctx.authenticated) return crow::response(401, JsonResponse::fail("Authentication required", "UNAUTHORIZED").dump());

        crow::multipart::message msg(req);
        std::string language = "en-US";
        std::string filename, mimeType, bytes;
        for (const auto& part : msg.parts) {
            auto nameIt = part.headers.find("Content-Disposition");
            if (nameIt == part.headers.end()) continue;
            std::string disposition = nameIt->second.value;
            if (disposition.find("name=\"language\"") != std::string::npos) {
                language = part.body;
            } else if (disposition.find("name=\"audio\"") != std::string::npos) {
                bytes = part.body;
                auto ctIt = part.headers.find("Content-Type");
                mimeType = ctIt != part.headers.end() ? ctIt->second.value : "audio/wav";
                auto fnPos = disposition.find("filename=\"");
                if (fnPos != std::string::npos) {
                    auto end = disposition.find('"', fnPos + 10);
                    filename = disposition.substr(fnPos + 10, end - (fnPos + 10));
                }
            }
        }
        Json result = service.transcribeUpload(ctx.userId, filename, mimeType, bytes, language);
        int status = result["success"] ? 200 : 400;
        return crow::response(status, result.dump());
    });

    // JSON variant used by the demo frontend for already-finalized transcripts
    CROW_ROUTE(app, "/api/stt/transcribe").methods(crow::HTTPMethod::Post)([&app](const crow::request& req) {
        auto& ctx = app.get_context<AuthMiddleware>(req);
        if (!ctx.authenticated) return crow::response(401, JsonResponse::fail("Authentication required", "UNAUTHORIZED").dump());
        return crow::response(200, JsonResponse::ok(Json::object(), "Use /api/stt/upload with multipart audio for real file transcription").dump());
    });
}

} // namespace voicetext
</file>

