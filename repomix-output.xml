        <div className="mt-5 flex flex-wrap gap-3">
          <QuickAction label="Voice to Text" icon={<Mic className="h-4 w-4" />} onClick={() => navigate("/voice-to-text")} />
          <QuickAction label="Text to Voice" icon={<Volume2 className="h-4 w-4" />} onClick={() => navigate("/text-to-voice")} />
          <QuickAction label="New Document" icon={<FileText className="h-4 w-4" />} onClick={() => navigate("/transcripts")} />
          <QuickAction label="History" icon={<FolderClock className="h-4 w-4" />} onClick={() => navigate("/history")} />
        </div>
      </div>

      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {stats.map((s) => (
          <Card key={s.label} className="animate-fade-in-up p-5">
            <div className={`mb-3 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br ${s.tone} text-white`}>
              <s.icon className="h-5 w-5" />
            </div>
            <p className="text-2xl font-bold text-slate-900 dark:text-white">{loading ? "—" : s.value}</p>
            <p className="text-sm text-slate-500 dark:text-slate-400">{s.label}</p>
          </Card>
        ))}
      </div>

      <div className="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
        <Card className="p-5 lg:col-span-2">
          <div className="mb-4 flex items-center justify-between">
            <h3 className="font-semibold text-slate-900 dark:text-white">Recent Transcripts</h3>
            <Button variant="ghost" size="sm" onClick={() => navigate("/transcripts")}>
              View all <ArrowUpRight className="h-3.5 w-3.5" />
            </Button>
          </div>
          {recentDocs.length === 0 ? (
            <EmptyState icon={<Mic className="h-6 w-6" />} title="No transcripts yet" description="Record your voice to generate your first transcript." />
          ) : (
            <ul className="divide-y divide-slate-100 dark:divide-slate-800">
              {recentDocs.map((d) => (
                <li key={d.id} className="flex items-center justify-between py-3">
                  <div>
                    <p className="text-sm font-medium text-slate-800 dark:text-slate-100">{d.title}</p>
                    <p className="text-xs text-slate-400">
                      {getLanguage(d.language).flag} {getLanguage(d.language).label} · {new Date(d.created_at).toLocaleDateString()}
                    </p>
                  </div>
                  {d.favorite && <Star className="h-4 w-4 fill-amber-400 text-amber-400" />}
                </li>
              ))}
            </ul>
          )}
        </Card>

        <Card className="p-5">
          <h3 className="mb-4 font-semibold text-slate-900 dark:text-white">Storage &amp; Usage</h3>
          <div className="mb-4 flex items-center gap-3">
            <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-500 dark:bg-slate-800">
              <HardDrive className="h-5 w-5" />
            </div>
            <div>
              <p className="text-sm font-semibold text-slate-800 dark:text-slate-100">{storageUsedKb} KB used</p>
              <p className="text-xs text-slate-400">Workspace storage</p>
            </div>
          </div>
          <h4 className="mb-2 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">
            <Globe2 className="h-3.5 w-3.5" /> Recently used languages
          </h4>
          <div className="flex flex-wrap gap-2">
            {languageUsage.length === 0 && <p className="text-sm text-slate-400">No activity yet</p>}
            {languageUsage.map(([code, count]) => (
              <Badge key={code} tone="indigo">
                {getLanguage(code).flag} {getLanguage(code).label} · {count}
              </Badge>
            ))}
          </div>
        </Card>
      </div>

      <Card className="mt-6 p-5">
        <div className="mb-4 flex items-center justify-between">
          <h3 className="font-semibold text-slate-900 dark:text-white">Recent Voice Generations</h3>
          <Button variant="ghost" size="sm" onClick={() => navigate("/text-to-voice")}>
            Create new <ArrowUpRight className="h-3.5 w-3.5" />
          </Button>
        </div>
        {recentTts.length === 0 ? (
          <EmptyState icon={<Volume2 className="h-6 w-6" />} title="No voice generations yet" description="Generate natural speech from any text in seconds." />
        ) : (
          <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {recentTts.map((t) => (
              <div key={t.id} className="rounded-xl border border-slate-100 p-3 dark:border-slate-800">
                <p className="line-clamp-2 text-sm text-slate-700 dark:text-slate-200">{t.text}</p>
                <p className="mt-2 text-xs text-slate-400">
                  {getLanguage(t.language).flag} {getLanguage(t.language).label} · {t.voice} · {t.speed}x
                </p>
              </div>
            ))}
          </div>
        )}
      </Card>
    </Layout>
  );
}

function QuickAction({ label, icon, onClick }: { label: string; icon: React.ReactNode; onClick: () => void }) {
  return (
    <button
      onClick={onClick}
      className="flex items-center gap-2 rounded-xl bg-white/15 px-4 py-2.5 text-sm font-medium text-white backdrop-blur transition hover:bg-white/25 active:scale-95"
    >
      {icon} {label}
    </button>
  );
}
</file>

<file path="src/pages/Favorites.tsx">
import { useEffect, useState } from "react";
import { Star, Mic, Volume2 } from "lucide-react";
import { Layout } from "../components/Layout";
import { Card, Badge, EmptyState, Button } from "../components/ui";
import { useAuth } from "../context/AuthContext";
import { transcriptApi, ttsApi } from "../lib/api";
import type { Transcript, TTSGeneration } from "../types";
import { getLanguage } from "../lib/languages";

export default function Favorites() {
  const { user } = useAuth();
  const [docs, setDocs] = useState<Transcript[]>([]);
  const [tts, setTts] = useState<TTSGeneration[]>([]);

  useEffect(() => {
    if (!user) return;
    load();
  }, [user]);

  function load() {
    if (!user) return;
    transcriptApi.list(user.id).then((r) => setDocs((r.data ?? []).filter((d) => d.favorite)));
    ttsApi.list(user.id).then((r) => setTts((r.data ?? []).filter((d) => d.favorite)));
  }

  async function unfavoriteDoc(d: Transcript) {
    await transcriptApi.update(d.id, { favorite: false, user_id: d.user_id });
    load();
  }

  async function unfavoriteTts(t: TTSGeneration) {
    await ttsApi.toggleFavorite(t.id, false);
    load();
  }

  const isEmpty = docs.length === 0 && tts.length === 0;

  return (
    <Layout title="Favorites">
      {isEmpty ? (
        <EmptyState icon={<Star className="h-6 w-6" />} title="No favorites yet" description="Star your best transcripts and voice generations to find them quickly here." />
      ) : (
        <div className="space-y-8">
          {docs.length > 0 && (
            <section>
              <h3 className="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-slate-400">
                <Mic className="h-4 w-4" /> Favorite Transcripts
              </h3>
              <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {docs.map((d) => (
                  <Card key={d.id} className="p-5">
                    <div className="mb-2 flex items-start justify-between">
                      <h4 className="font-semibold text-slate-800 dark:text-slate-100">{d.title}</h4>
                      <button onClick={() => unfavoriteDoc(d)}>
                        <Star className="h-4 w-4 fill-amber-400 text-amber-400" />
                      </button>
                    </div>
                    <p className="mb-3 line-clamp-3 text-sm text-slate-500 dark:text-slate-400">{d.content}</p>
                    <Badge tone="indigo">
                      {getLanguage(d.language).flag} {getLanguage(d.language).label}
                    </Badge>
                  </Card>
                ))}
              </div>
            </section>
          )}

          {tts.length > 0 && (
            <section>
              <h3 className="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-slate-400">
                <Volume2 className="h-4 w-4" /> Favorite Voice Generations
              </h3>
              <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {tts.map((t) => (
                  <Card key={t.id} className="p-5">
                    <div className="mb-2 flex items-start justify-between">
                      <p className="line-clamp-3 flex-1 text-sm text-slate-700 dark:text-slate-200">{t.text}</p>
                      <button onClick={() => unfavoriteTts(t)} title="Unfavorite" className="ml-2">
                        <Star className="h-4 w-4 fill-amber-400 text-amber-400" />
                      </button>
                    </div>
                    <Badge tone="green">
                      {getLanguage(t.language).flag} {t.voice}
                    </Badge>
                  </Card>
                ))}
              </div>
            </section>
          )}

          <Button variant="ghost" size="sm" onClick={load}>
            Refresh
          </Button>
        </div>
      )}
    </Layout>
  );
}
</file>

<file path="src/pages/History.tsx">
import { useEffect, useMemo, useState } from "react";
import { Search, ChevronLeft, ChevronRight, Star, Mic, Volume2, Sparkles, Languages } from "lucide-react";
import type { ReactElement } from "react";
import { Layout } from "../components/Layout";
import { Card, Input, Select, Badge, EmptyState } from "../components/ui";
import { useAuth } from "../context/AuthContext";
import { transcriptApi, ttsApi } from "../lib/api";
import type { DocumentType, Transcript, TTSGeneration } from "../types";
import { getLanguage } from "../lib/languages";

type Row = {
  id: string;
  name: string;
  type: DocumentType;
  language: string;
  created_at: string;
  updated_at: string;
  duration?: number | null;
  status: string;
  favorite: boolean;
};

const FILTERS = ["All", "Voice-to-Text", "Text-to-Voice", "Favorites", "Recent"] as const;
const PAGE_SIZE = 6;

export default function History() {
  const { user } = useAuth();
  const [rows, setRows] = useState<Row[]>([]);
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState<(typeof FILTERS)[number]>("All");
  const [sortDesc, setSortDesc] = useState(true);
  const [page, setPage] = useState(1);

  useEffect(() => {
    if (!user) return;
    Promise.all([transcriptApi.list(user.id), ttsApi.list(user.id)]).then(([t, v]) => {
      const tRows: Row[] = (t.data ?? []).map((d: Transcript) => ({
        id: d.id,
        name: d.title,
        type: d.type,
        language: d.language,
        created_at: d.created_at,
        updated_at: d.updated_at,
        duration: d.duration,
        status: d.status,
        favorite: d.favorite,
      }));
      const vRows: Row[] = (v.data ?? []).map((d: TTSGeneration) => ({
        id: d.id,
        name: d.text.slice(0, 40) + (d.text.length > 40 ? "…" : ""),
        type: "text_to_voice",
        language: d.language,
        created_at: d.created_at,
        updated_at: d.created_at,
        duration: null,
        status: d.status,
        favorite: d.favorite,
      }));
      setRows([...tRows, ...vRows]);
    });
  }, [user]);

  async function toggleRowFavorite(row: Row) {
    const next = !row.favorite;
    if (row.type === "text_to_voice") {
      await ttsApi.toggleFavorite(row.id, next);
    } else {
      await transcriptApi.update(row.id, { favorite: next, user_id: user?.id });
    }
    setRows((prev) => prev.map((r) => (r.id === row.id ? { ...r, favorite: next } : r)));
  }

  const filtered = useMemo(() => {
    let data = rows.filter((r) => r.name.toLowerCase().includes(search.toLowerCase()));
    if (filter === "Voice-to-Text") data = data.filter((r) => r.type === "voice_to_text");
    if (filter === "Text-to-Voice") data = data.filter((r) => r.type === "text_to_voice");
    if (filter === "Favorites") data = data.filter((r) => r.favorite);
    if (filter === "Recent") data = data.filter((r) => Date.now() - new Date(r.created_at).getTime() < 1000 * 60 * 60 * 24 * 7);
    data = [...data].sort((a, b) => (sortDesc ? +new Date(b.created_at) - +new Date(a.created_at) : +new Date(a.created_at) - +new Date(b.created_at)));
    return data;
  }, [rows, search, filter, sortDesc]);

  const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
  const pageRows = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

  return (
    <Layout title="History">
      <div className="mb-5 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div className="relative w-full max-w-sm">
          <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
          <Input
            value={search}
            onChange={(e) => {
              setSearch(e.target.value);
              setPage(1);
            }}
            placeholder="Search history…"
            className="pl-9"
          />
        </div>
        <div className="flex flex-wrap items-center gap-2">
          {FILTERS.map((f) => (
            <button
              key={f}
              onClick={() => {
                setFilter(f);
                setPage(1);
              }}
              className={`rounded-full px-3.5 py-1.5 text-sm font-medium transition ${
                filter === f ? "bg-indigo-600 text-white shadow" : "bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300"
              }`}
            >
              {f}
            </button>
          ))}
          <Select value={sortDesc ? "desc" : "asc"} onChange={(e) => setSortDesc(e.target.value === "desc")} className="w-auto">
            <option value="desc">Newest first</option>
            <option value="asc">Oldest first</option>
          </Select>
        </div>
      </div>

      <Card className="overflow-hidden">
        {pageRows.length === 0 ? (
          <EmptyState icon={<Languages className="h-6 w-6" />} title="No history found" description="Your conversions and AI operations will appear here." />
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full min-w-[720px] text-left text-sm">
              <thead className="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-400 dark:border-slate-800">
                <tr>
                  <th className="px-4 py-3">Document</th>
                  <th className="px-4 py-3">Type</th>
                  <th className="px-4 py-3">Language</th>
                  <th className="px-4 py-3">Created</th>
                  <th className="px-4 py-3">Duration</th>
                  <th className="px-4 py-3">Status</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100 dark:divide-slate-800">
                {pageRows.map((r) => (
                  <tr key={r.id} className="transition hover:bg-slate-50 dark:hover:bg-slate-800/50">
                    <td className="flex items-center gap-2 px-4 py-3 font-medium text-slate-700 dark:text-slate-200">
                      <button onClick={() => toggleRowFavorite(r)} title={r.favorite ? "Unfavorite" : "Favorite"}>
                        <Star className={`h-3.5 w-3.5 ${r.favorite ? "fill-amber-400 text-amber-400" : "text-slate-300 hover:text-slate-500"}`} />
                      </button>
                      {r.name}
                    </td>
                    <td className="px-4 py-3">
                      <TypeBadge type={r.type} />
                    </td>
                    <td className="px-4 py-3 text-slate-500 dark:text-slate-400">
                      {getLanguage(r.language).flag} {getLanguage(r.language).label}
                    </td>
                    <td className="px-4 py-3 text-slate-500 dark:text-slate-400">{new Date(r.created_at).toLocaleString()}</td>
                    <td className="px-4 py-3 text-slate-500 dark:text-slate-400">{r.duration ? `${r.duration}s` : "—"}</td>
                    <td className="px-4 py-3">
                      <Badge tone={r.status === "demo" ? "amber" : "green"}>{r.status}</Badge>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {filtered.length > 0 && (
          <div className="flex items-center justify-between border-t border-slate-100 px-4 py-3 text-sm text-slate-500 dark:border-slate-800">
            <span>
              Page {page} of {totalPages}
            </span>
            <div className="flex gap-2">
              <button
                disabled={page <= 1}
                onClick={() => setPage((p) => p - 1)}
                className="rounded-lg border border-slate-200 p-1.5 disabled:opacity-40 dark:border-slate-700"
              >
                <ChevronLeft className="h-4 w-4" />
              </button>
              <button
                disabled={page >= totalPages}
                onClick={() => setPage((p) => p + 1)}
                className="rounded-lg border border-slate-200 p-1.5 disabled:opacity-40 dark:border-slate-700"
              >
                <ChevronRight className="h-4 w-4" />
              </button>
            </div>
          </div>
        )}
      </Card>
    </Layout>
  );
}

function TypeBadge({ type }: { type: DocumentType }) {
  const map: Record<DocumentType, { label: string; icon: ReactElement; tone: "indigo" | "green" | "amber" | "rose" }> = {
    voice_to_text: { label: "Voice to Text", icon: <Mic className="mr-1 inline h-3 w-3" />, tone: "indigo" },
    text_to_voice: { label: "Text to Voice", icon: <Volume2 className="mr-1 inline h-3 w-3" />, tone: "green" },
    ai_summary: { label: "AI Summary", icon: <Sparkles className="mr-1 inline h-3 w-3" />, tone: "amber" },
    translation: { label: "Translation", icon: <Languages className="mr-1 inline h-3 w-3" />, tone: "rose" },
  };
  const m = map[type];
  return (
    <Badge tone={m.tone}>
      {m.icon}
      {m.label}
    </Badge>
  );
}
</file>

<file path="src/pages/Login.tsx">
import { useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { AudioLines, Eye, EyeOff, Mic, Volume2, Sparkles } from "lucide-react";
import { useAuth } from "../context/AuthContext";
import { useToast } from "../context/ToastContext";
import { Button, Input, Spinner } from "../components/ui";

export default function Login() {
  const { login } = useAuth();
  const { push } = useToast();
  const navigate = useNavigate();
  const [email, setEmail] = useState("demo@voicetext.ai");
  const [password, setPassword] = useState("");
  const [showPw, setShowPw] = useState(false);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const submit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError("");
    setLoading(true);
    const res = await login(email, password);
    setLoading(false);
    if (res.success) {
      push("Welcome back to VoiceText AI!", "success");
      navigate("/dashboard");
    } else {
      setError(res.message);
    }
  };

  return (
    <AuthShell>
      <div className="mb-8">
        <div className="mb-4 flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 to-violet-600 text-white shadow-lg shadow-indigo-500/30">
          <AudioLines className="h-6 w-6" />
        </div>
        <h1 className="text-2xl font-bold text-slate-900 dark:text-white">Welcome back</h1>
        <p className="mt-1 text-sm text-slate-500 dark:text-slate-400">Sign in to continue to your voice workspace.</p>
      </div>

      <form onSubmit={submit} className="space-y-4">
        <div>
          <label className="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Email address</label>
          <Input type="email" required value={email} onChange={(e) => setEmail(e.target.value)} placeholder="you@company.com" />
        </div>
        <div>
          <label className="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Password</label>
          <div className="relative">
            <Input type={showPw ? "text" : "password"} required value={password} onChange={(e) => setPassword(e.target.value)} placeholder="••••••••" />
            <button type="button" onClick={() => setShowPw((s) => !s)} className="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">
              {showPw ? <EyeOff className="h-4 w-4" /> : <Eye className="h-4 w-4" />}
            </button>
          </div>
        </div>

        {error && <p className="rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-600 dark:bg-rose-500/10">{error}</p>}

        <Button type="submit" disabled={loading} className="w-full justify-center">
          {loading ? <Spinner /> : "Sign In"}
        </Button>
      </form>

      <p className="mt-6 text-center text-sm text-slate-500 dark:text-slate-400">
        Don't have an account?{" "}
        <Link to="/register" className="font-semibold text-indigo-600 hover:underline dark:text-indigo-400">
          Create one free
        </Link>
      </p>

      <div className="mt-6 rounded-xl border border-dashed border-slate-300 p-3 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">
        Create an account to get started. When the C++ backend is unavailable, the app switches to a browser-only demo account.
      </div>
    </AuthShell>
  );
}

export function AuthShell({ children }: { children: React.ReactNode }) {
  return (
    <div className="grid min-h-screen grid-cols-1 lg:grid-cols-2">
      <div className="flex items-center justify-center bg-white px-6 py-12 dark:bg-slate-900">
        <div className="w-full max-w-sm">{children}</div>
      </div>
      <div className="relative hidden overflow-hidden bg-gradient-to-br from-indigo-700 via-violet-700 to-fuchsia-700 lg:flex lg:items-center lg:justify-center">
        <div className="absolute -left-20 -top-20 h-72 w-72 rounded-full bg-white/10 blur-3xl" />
        <div className="absolute -bottom-24 -right-10 h-80 w-80 rounded-full bg-fuchsia-400/20 blur-3xl" />
        <div className="relative z-10 max-w-md px-10 text-white">
          <div className="mb-8 flex gap-3">
            <div className="float-y flex h-14 w-14 items-center justify-center rounded-2xl bg-white/15 backdrop-blur">
              <Mic className="h-7 w-7" />
            </div>
            <div className="float-y flex h-14 w-14 items-center justify-center rounded-2xl bg-white/15 backdrop-blur" style={{ animationDelay: "0.6s" }}>
              <Volume2 className="h-7 w-7" />
            </div>
            <div className="float-y flex h-14 w-14 items-center justify-center rounded-2xl bg-white/15 backdrop-blur" style={{ animationDelay: "1.2s" }}>
              <Sparkles className="h-7 w-7" />
            </div>
          </div>
          <h2 className="text-3xl font-bold leading-tight">Every voice, instantly understood.</h2>
          <p className="mt-4 text-indigo-100/90">
            VoiceText AI converts speech to text and text to natural speech in English, Urdu, Hindi, Pashto, and Arabic —
            backed by a modular C++ service architecture and AI-powered editing tools.
          </p>
          <ul className="mt-8 space-y-3 text-sm text-indigo-100/90">
            {["Real-time dictation with live transcript preview", "Natural multi-voice text-to-speech", "AI summarize, translate & rewrite", "Secure, private, and fully exportable"].map((f) => (
              <li key={f} className="flex items-center gap-2">
                <span className="h-1.5 w-1.5 rounded-full bg-emerald-300" /> {f}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  );
}
