# VoiceText AI — example environment configuration.
# Copy this file to config/.env and fill in real values for production.
# Never commit the real config/.env file to version control.

# --- Application ---------------------------------------------------------
APP_ENV=development
APP_MODE=demo
SERVER_PORT=8080

# --- Database -------------------------------------------------------------
DATABASE_PATH=./data/voicetext.db

# --- Storage ---------------------------------------------------------------
STORAGE_PATH=./storage

# --- Authentication ---------------------------------------------------------
# Used to sign session tokens. Generate a long random value in production,
# e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Speech-to-Text provider (leave blank to run in demo mode) -------------
STT_PROVIDER=
STT_API_KEY=

# --- Text-to-Speech provider (leave blank to run in demo mode) -------------
TTS_PROVIDER=
TTS_API_KEY=

# --- AI text processing provider (leave blank to run in demo mode) ---------
AI_PROVIDER=
AI_API_KEY=

# --- CORS -------------------------------------------------------------------
ALLOWED_ORIGIN=http://localhost:5173
